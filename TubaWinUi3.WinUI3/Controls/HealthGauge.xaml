<UserControl
    x:Class="TubaWinUi3.Controls.HealthGauge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gauge="using:Syncfusion.UI.Xaml.Gauges"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HG_OuterTickBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="HG_InnerTrackBrush" Color="#08000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HG_OuterTickBrush" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="HG_InnerTrackBrush" Color="#18FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="HG_RedBrush" Color="#F40000" />
            <SolidColorBrush x:Key="HG_YellowBrush" Color="#F48F2C" />
            <SolidColorBrush x:Key="HG_BlueBrush" Color="#3A7BFF" />

            <SolidColorBrush x:Key="HG_RedLight" Color="#F54D4C" />
            <SolidColorBrush x:Key="HG_YellowLight" Color="#F8B777" />
            <SolidColorBrush x:Key="HG_BlueLight" Color="#6AA4FF" />

            <SolidColorBrush x:Key="HG_RedLighter" Color="#F8A4A4" />
            <SolidColorBrush x:Key="HG_YellowLighter" Color="#F7AFA7" />
            <SolidColorBrush x:Key="HG_BlueLighter" Color="#AEDCFF" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,0,10,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <gauge:SfRadialGauge Width="220" Height="220">
            <gauge:SfRadialGauge.Axes>
                <!-- Outer tick marks -->
                <gauge:RadialAxis
                    AxisLineFill="Transparent"
                    AxisLineWidth="20"
                    Background="Transparent"
                    RadiusFactor="0.92"
                    ShowLabels="False"
                    ShowTicks="False">
                    <gauge:RadialAxis.Ranges>
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="1" EndWidth="8" StartValue="0" StartWidth="8" />
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="11.5" EndWidth="8" StartValue="13.5" StartWidth="8" />
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="24" EndWidth="8" StartValue="26" StartWidth="8" />
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="36.5" EndWidth="8" StartValue="38.5" StartWidth="8" />
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="49" EndWidth="8" StartValue="51" StartWidth="8" />
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="61.5" EndWidth="8" StartValue="63.5" StartWidth="8" />
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="74" EndWidth="8" StartValue="76" StartWidth="8" />
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="86.5" EndWidth="8" StartValue="88.5" StartWidth="8" />
                        <gauge:GaugeRange Background="{ThemeResource HG_OuterTickBrush}" EndValue="99" EndWidth="8" StartValue="100" StartWidth="8" />
                    </gauge:RadialAxis.Ranges>
                </gauge:RadialAxis>

                <!-- Inner value arc -->
                <gauge:RadialAxis
                    AxisLineFill="Transparent"
                    AxisLineWidth="0.15"
                    AxisLineWidthUnit="Factor"
                    Background="Transparent"
                    RadiusFactor="0.75"
                    ShowLabels="False"
                    ShowTicks="False">
                    <gauge:RadialAxis.Ranges>
                        <gauge:GaugeRange Background="{ThemeResource HG_InnerTrackBrush}" CornerRadius="2" EndValue="24" EndWidth="300" StartValue="0" StartWidth="300" />
                        <gauge:GaugeRange Background="{ThemeResource HG_InnerTrackBrush}" CornerRadius="2" EndValue="49" EndWidth="300" StartValue="26" StartWidth="300" />
                        <gauge:GaugeRange Background="{ThemeResource HG_InnerTrackBrush}" CornerRadius="2" EndValue="74" EndWidth="400" StartValue="51" StartWidth="400" />
                        <gauge:GaugeRange Background="{ThemeResource HG_InnerTrackBrush}" CornerRadius="2" EndValue="100" EndWidth="300" StartValue="76" StartWidth="300" />
                    </gauge:RadialAxis.Ranges>

                    <gauge:RadialAxis.Pointers>
                        <gauge:RangePointer
                            x:Name="redPointer"
                            Background="{x:Bind PointerBrush, Mode=OneWay}"
                            CornerStyle="BothFlat"
                            EnableAnimation="True"
                            OffsetUnit="Factor"
                            PointerOffset=".24"
                            PointerWidth="1"
                            WidthUnit="Factor"
                            Value="{x:Bind Value, Mode=TwoWay}">
                            <gauge:RangePointer.AnimationEasingFunction>
                                <CircleEase EasingMode="EaseInOut" />
                            </gauge:RangePointer.AnimationEasingFunction>
                        </gauge:RangePointer>

                        <gauge:RangePointer
                            x:Name="rangePointer"
                            CornerRadius="0.1"
                            CornerStyle="BothFlat"
                            EnableAnimation="True"
                            PointerWidth="0.18"
                            ValueChanged="rangePointer_ValueChanged"
                            Visibility="Visible"
                            WidthUnit="Factor"
                            Value="{x:Bind Value, Mode=TwoWay}">
                            <gauge:RangePointer.AnimationEasingFunction>
                                <CircleEase EasingMode="EaseInOut" />
                            </gauge:RangePointer.AnimationEasingFunction>
                            <gauge:RangePointer.GradientStops>
                                <gauge:GaugeGradientStop x:Name="gradient0" Color="{x:Bind Color1, Mode=OneWay}" Value="0" />
                                <gauge:GaugeGradientStop x:Name="gradient1" Color="{x:Bind Color2, Mode=OneWay}" Value="0" />
                                <gauge:GaugeGradientStop x:Name="gradient2" Color="{x:Bind Color3, Mode=OneWay}" Value="0" />
                            </gauge:RangePointer.GradientStops>
                        </gauge:RangePointer>
                    </gauge:RadialAxis.Pointers>

                    <gauge:RadialAxis.Annotations>
                        <gauge:GaugeAnnotation DirectionUnit="AxisValue" DirectionValue="{x:Bind Value, Mode=TwoWay}">
                            <TextBlock Margin="0,-10,0,0">
                                <Span FontSize="40" FontWeight="SemiBold">
                                    <Run Text="{x:Bind Value, Mode=OneWay}" />
                                </Span>
                                <Span FontSize="40" FontWeight="SemiBold">
                                    <Run FontSize="24" Text="%" />
                                </Span>
                            </TextBlock>
                        </gauge:GaugeAnnotation>
                        <gauge:GaugeAnnotation
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            DirectionUnit="AxisValue"
                            DirectionValue="100"
                            PositionFactor="0">
                            <TextBlock Margin="0,48,0,0" HorizontalTextAlignment="Center">
                                <Span FontSize="20" FontWeight="Normal">
                                    <Run Text="{x:Bind Label, Mode=OneWay}" />
                                </Span>
                                <LineBreak />
                                <Span FontWeight="SemiBold">
                                    <Run FontSize="24" Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                </Span>
                            </TextBlock>
                        </gauge:GaugeAnnotation>
                    </gauge:RadialAxis.Annotations>
                </gauge:RadialAxis>
            </gauge:SfRadialGauge.Axes>
        </gauge:SfRadialGauge>
    </Grid>
</UserControl>
