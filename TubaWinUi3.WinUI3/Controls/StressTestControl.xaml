<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TubaWinUi3.Controls.StressTestControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel Spacing="14" MaxWidth="960">

                <Border x:Name="AidaStatusBorder" Padding="14,10" BorderThickness="1" CornerRadius="6"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="AidaStatusIcon" FontSize="16" Glyph="&#xE7BA;" />
                        <TextBlock x:Name="AidaStatusText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="正在检测 AIDA64 WMI 连接..." />
                    </StackPanel>
                </Border>

                <Border Padding="12,8,12,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DualStressBtn" Click="DualStress_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xECAD;" />
                                <TextBlock Text="一键双烤" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CpuStressBtn" Grid.Column="1" Click="CpuStress_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xEEA1;" />
                                <TextBlock Text="CPU 单烤" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GpuStressBtn" Grid.Column="2" Click="GpuStress_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xF211;" />
                                <TextBlock Text="GPU 单烤" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportBtn" Grid.Column="4" Click="Export_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xEDE1;" />
                                <TextBlock Text="导出报告" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopBtn" Grid.Column="5" Click="Stop_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE71A;" />
                                <TextBlock Text="停止" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border BorderThickness="1" CornerRadius="6" Padding="16"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="烤机时长设置" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Opacity="0.8" Text="CPU 单烤时长 (分钟)" />
                                <NumberBox x:Name="CpuDurationBox" Value="15" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="12" Opacity="0.8" Text="GPU 单烤时长 (分钟)" />
                                <NumberBox x:Name="GpuDurationBox" Value="15" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock FontSize="12" Opacity="0.8" Text="双烤时长 (分钟)" />
                                <NumberBox x:Name="DualDurationBox" Value="15" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140" />
                            </StackPanel>
                        </Grid>
                        <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="时长含义：" />
                            <Run Text="CPU 单烤 15 分钟 — 快速验证 CPU 散热与稳定性；30 分钟 — 常规稳定性测试；1 小时+ — 深度烤机。" />
                            <LineBreak />
                            <Run Text="GPU 单烤 15 分钟 — 快速验证 GPU 散热；30 分钟 — 常规测试；1 小时+ — 长时间压力测试。" />
                            <LineBreak />
                            <Run Text="双烤 15 分钟 — 快速检验整机散热能力；30 分钟 — 常规双负载测试；1 小时+ — 极限散热与电源验证。" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.8" Text="CPU 温度" />
                            <TextBlock x:Name="CpuTempText" FontSize="22" FontWeight="Bold" Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.8" Text="CPU 占用" />
                            <TextBlock x:Name="CpuUsageText" FontSize="22" FontWeight="Bold" Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.8" Text="CPU 频率" />
                            <TextBlock x:Name="CpuClockText" FontSize="22" FontWeight="Bold" Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.8" Text="CPU 功耗" />
                            <TextBlock x:Name="CpuPowerText" FontSize="22" FontWeight="Bold" Text="--" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.8" Text="GPU 温度" />
                            <TextBlock x:Name="GpuTempText" FontSize="22" FontWeight="Bold" Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.8" Text="GPU 频率" />
                            <TextBlock x:Name="GpuClockText" FontSize="22" FontWeight="Bold" Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.8" Text="GPU 功耗" />
                            <TextBlock x:Name="GpuPowerText" FontSize="22" FontWeight="Bold" Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.8" Text="已运行" />
                            <TextBlock x:Name="ElapsedText" FontSize="22" FontWeight="Bold" Text="0:00" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border BorderThickness="1" CornerRadius="6" Padding="12"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="CPU 监控曲线" />
                        <Grid ColumnSpacing="8" Height="120">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="10" Opacity="0.6" Text="温度 (°C)" HorizontalAlignment="Center" />
                                    <lvc:CartesianChart x:Name="CpuTempChart" Grid.Row="1" Background="Transparent" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="10" Opacity="0.6" Text="占用 (%)" HorizontalAlignment="Center" />
                                    <lvc:CartesianChart x:Name="CpuUsageChart" Grid.Row="1" Background="Transparent" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="10" Opacity="0.6" Text="频率 (MHz)" HorizontalAlignment="Center" />
                                    <lvc:CartesianChart x:Name="CpuClockChart" Grid.Row="1" Background="Transparent" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="10" Opacity="0.6" Text="功耗 (W)" HorizontalAlignment="Center" />
                                    <lvc:CartesianChart x:Name="CpuPowerChart" Grid.Row="1" Background="Transparent" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderThickness="1" CornerRadius="6" Padding="12"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="GPU 监控曲线" />
                        <Grid ColumnSpacing="8" Height="120">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="10" Opacity="0.6" Text="温度 (°C)" HorizontalAlignment="Center" />
                                    <lvc:CartesianChart x:Name="GpuTempChart" Grid.Row="1" Background="Transparent" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="10" Opacity="0.6" Text="频率 (MHz)" HorizontalAlignment="Center" />
                                    <lvc:CartesianChart x:Name="GpuClockChart" Grid.Row="1" Background="Transparent" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="10" Opacity="0.6" Text="功耗 (W)" HorizontalAlignment="Center" />
                                    <lvc:CartesianChart x:Name="GpuPowerChart" Grid.Row="1" Background="Transparent" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderThickness="1" CornerRadius="6" Padding="16"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="运行日志" />
                            <Button Grid.Column="1" Click="ClearLog_Click" ToolTipService.ToolTip="清空日志">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>
                        <Border BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" Padding="8" CornerRadius="4">
                            <ScrollViewer x:Name="LogScrollViewer" Height="100" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
