<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:FavGlyphConverter x:Key="FavGlyphConverter" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis" />
        <local:NullToVisibilityConverter x:Key="NullToCollapse" />
        <local:HasAlternatesToVisibilityConverter x:Key="HasAlternatesToVis" />
        <local:NoAlternatesToVisibilityConverter x:Key="NoAlternatesToVis" />

        <local:ZeroToIndeterminateConverter x:Key="ZeroIsIndeterminate" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis2" />
        <Style x:Key="TagRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactSearchBoxStyle" TargetType="AutoSuggestBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="8,2,8,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ToolCardStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CompactCardStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid Padding="28,18,28,24" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="CategoryTitle"
                        FontSize="30"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="ToolCountText"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,4"
                        FontSize="14"
                        Opacity="1.0" />
                </StackPanel>
                <TextBlock
                    x:Name="CategorySubtitle"
                    Opacity="1.0" />
            </StackPanel>


        </Grid>

        <ScrollViewer
            x:Name="TagBarScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            Visibility="Collapsed">
            <StackPanel x:Name="TagBarPanel" Orientation="Horizontal" Spacing="6" />
        </ScrollViewer>

        <Grid Grid.Row="2">
            <GridView
                x:Name="ToolsGrid"
                IsItemClickEnabled="True"
                ItemClick="ToolsGrid_ItemClick"
                DoubleTapped="ToolsGrid_DoubleTapped"
                ItemContainerStyle="{StaticResource ToolCardStyle}"
                SelectionMode="None"
                SizeChanged="ToolsGrid_SizeChanged"
                Visibility="Collapsed">
                    <GridView.Resources>
                        <MenuFlyout x:Key="NormalItemFlyout">
                            <MenuFlyoutItem Text="发送到桌面快捷方式" Click="NormalMenu_SendToDesktop" Icon="Link" />
                            <MenuFlyoutItem Text="以管理员身份运行" Click="NormalMenu_RunAsAdmin" Icon="Admin" />
                            <MenuFlyoutItem Text="打开工具所在目录" Click="NormalMenu_OpenDirectory" Icon="Folder" />
                            <MenuFlyoutItem x:Name="NormalMenuOpenTutorial" Text="打开教程" Click="NormalMenu_OpenTutorial" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="NormalArchSubmenu" Text="选择架构" Visibility="Collapsed">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE912;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="删除工具" Click="NormalMenu_DeleteTool" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </GridView.Resources>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="16"
                                MinHeight="220"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                RightTapped="NormalItem_RightTapped">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="12">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="56" />
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <Border
                                             Width="56"
                                             Height="56"
                                             Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                             CornerRadius="8">
                                             <Grid>
                                                 <Image
                                                     Width="40"
                                                     Height="40"
                                                     Source="{Binding IconPath}"
                                                     Stretch="Uniform"
                                                     Visibility="{Binding IconPath, Converter={StaticResource NullToCollapse}}" />
                                                 <FontIcon
                                                     FontSize="28"
                                                     Glyph="{Binding IconGlyph}"
                                                     Visibility="{Binding IconGlyph, Converter={StaticResource NullToCollapse}}" />
                                             </Grid>
                                         </Border>
                                         <StackPanel Grid.Column="1" Spacing="3">
                                             <TextBlock
                                                 FontFamily="{StaticResource AppFontFamily}"
                                                 FontSize="18"
                                                 FontWeight="SemiBold"
                                                 MaxLines="1"
                                                 Text="{Binding Name}"
                                                 TextTrimming="CharacterEllipsis" />
                                             <StackPanel Orientation="Horizontal" Spacing="4">
                                                 <TextBlock
                                                     FontFamily="{StaticResource AppFontFamily}"
                                                     FontSize="12"
                                                     Opacity="1.0"
                                                     Text="{Binding Category}"
                                                     TextTrimming="CharacterEllipsis" />
                                                 <TextBlock
                                                     FontFamily="{StaticResource AppFontFamily}"
                                                     FontSize="12"
                                                     Opacity="1.0"
                                                     Text="{Binding CategoriesDisplay}"
                                                     TextTrimming="CharacterEllipsis"
                                                     Visibility="{Binding CategoriesDisplay, Converter={StaticResource NullToCollapse}}" />
                                             </StackPanel>
                                         </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            VerticalAlignment="Top"
                                            Click="FavoriteButton_Click"
                                            ToolTipService.ToolTip="收藏">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{Binding IsFavorite, Converter={StaticResource FavGlyphConverter}}" />
                                        </Button>
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="1"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        MaxLines="2"
                                        Opacity="1.0"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        FontSize="10"
                                        MaxLines="1"
                                        Opacity="1.0"
                                        Text="{Binding TagsText}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding TagsText, Converter={StaticResource NullToCollapse}}" />

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                                        <Border
                                            VerticalAlignment="Center"
                                            Padding="8,3"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{Binding Extension}" />
                                        </Border>

                                    </StackPanel>

                                    <Grid Grid.Row="4" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="0"
                                            Click="SendToDesktopButton_Click"
                                            ToolTipService.ToolTip="发送到桌面快捷方式"
                                            Visibility="{Binding CanSendToDesktop, Converter={StaticResource BoolToVis}}">
                                            <FontIcon FontSize="12" Glyph="&#xE8BD;" />
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="0"
                                            Click="RunAsAdminButton_Click"
                                            ToolTipService.ToolTip="以管理员身份运行"
                                            Visibility="{Binding NeedsDownload, Converter={StaticResource InvertBoolToVis}}">
                                            <FontIcon FontSize="12" Glyph="&#xE7EF;" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="88"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="10,4"
                                            Click="LaunchButton_Click"
                                            IsEnabled="{Binding CanLaunch}">
                                            <TextBlock
                                                FontFamily="{StaticResource AppFontFamily}"
                                                Text="{Binding LaunchButtonText}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

            <GridView
                x:Name="CompactGrid"
                IsItemClickEnabled="True"
                ItemClick="CompactGrid_ItemClick"
                DoubleTapped="CompactGrid_DoubleTapped"
                ItemContainerStyle="{StaticResource CompactCardStyle}"
                SelectionMode="None"
                SizeChanged="CompactGrid_SizeChanged"
                Visibility="Collapsed">
                    <GridView.Resources>
                        <MenuFlyout x:Key="CompactItemFlyout">
                            <MenuFlyoutItem Text="发送到桌面快捷方式" Click="CompactMenu_SendToDesktop" Icon="Link" />
                            <MenuFlyoutItem Text="以管理员身份运行" Click="CompactMenu_RunAsAdmin" Icon="Admin" />
                            <MenuFlyoutItem Text="打开工具所在目录" Click="CompactMenu_OpenDirectory" Icon="Folder" />
                            <MenuFlyoutItem x:Name="CompactMenuOpenTutorial" Text="打开教程" Click="CompactMenu_OpenTutorial" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="CompactArchSubmenu" Text="选择架构" Visibility="Collapsed">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE912;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="删除工具" Click="CompactMenu_DeleteTool" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </GridView.Resources>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="8,10,8,6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                RightTapped="CompactItem_RightTapped"
                                ToolTipService.ToolTip="{Binding Description}">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <Border
                                        Width="52"
                                        Height="52"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <Grid>
                                            <Image
                                                Width="38"
                                                Height="38"
                                                Source="{Binding IconPath}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconPath, Converter={StaticResource NullToCollapse}}" />
                                            <FontIcon
                                                FontSize="26"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Glyph="{Binding IconGlyph}"
                                                Visibility="{Binding IconGlyph, Converter={StaticResource NullToCollapse}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        FontFamily="{StaticResource AppFontFamily}"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        MaxLines="2"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Width="84" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Glyph="&#xE721;"
                    Opacity="1.0" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    Opacity="1.0"
                    Text="没有找到匹配的工具" />
                <TextBlock
                    x:Name="EmptyStateText"
                    HorizontalAlignment="Center"
                    Opacity="1.0"
                    Text="" />
                <Button
                    x:Name="DownloadToolsButton"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="DownloadToolsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="下载工具包" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TeachingTip
                x:Name="ToolDetailTip"
                CloseButtonContent="关闭"
                PreferredPlacement="Right">
                <StackPanel MaxWidth="420" Spacing="8">
                    <TextBlock x:Name="DetailDescriptionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPublisherText" Opacity="1.0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailVersionText" Opacity="1.0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPathText" Opacity="1.0" TextWrapping="Wrap" />
                </StackPanel>
            </TeachingTip>

            <InfoBar
                x:Name="StatusBar"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsOpen="False"
                IsClosable="True" />
        </Grid>
    </Grid>
    </Grid>
</Page>
