<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.MemoryManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏 ===== -->
        <Grid Padding="20,16,20,12" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="BackButton_Click" ToolTipService.ToolTip="返回" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    <TextBlock FontSize="13" Text="返回" />
                </StackPanel>
            </Button>
            <Border Grid.Column="1" Width="36" Height="36" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE963;" />
            </Border>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="Bold" Text="内存管理" />
                <TextBlock FontSize="12" Opacity="0.7" Text="RAMMap 优化版 · 清理与分析 · 虚拟内存设置" />
            </StackPanel>
            <Button x:Name="HelpButton" Grid.Column="3" Click="HelpButton_Click" VerticalAlignment="Center"
                    ToolTipService.ToolTip="了解内存概念的帮助">
                <FontIcon Glyph="&#xE897;" FontSize="14" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="4" Click="CloseButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== 清理操作栏 ===== -->
        <Grid Grid.Row="1" Padding="20,14,20,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CleanAllButton" Grid.Column="0" Click="CleanAllButton_Click"
                    Style="{ThemeResource AccentButtonStyle}" MinWidth="110"
                    Content="全部清理" ToolTipService.ToolTip="调用 RAMMap 依次清理待机内存并收紧系统工作集" />
            <Button x:Name="CleanStandbyButton" Grid.Column="1" Click="CleanStandbyButton_Click" MinWidth="110"
                    Content="清理待机内存" ToolTipService.ToolTip="调用 RAMMap 清空待机列表与已修改内存列表" />
            <Button x:Name="TrimWorkingSetButton" Grid.Column="2" Click="TrimWorkingSetButton_Click" MinWidth="120"
                    Content="收紧系统工作集" ToolTipService.ToolTip="调用 RAMMap 清空所有进程工作集并收缩系统文件缓存" />
            <Button x:Name="OpenRamMapButton" Grid.Column="3" Click="OpenRamMapButton_Click"
                    ToolTipService.ToolTip="打开 RAMMap 图形界面，深入分析物理内存使用情况">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A9;" FontSize="12" />
                    <TextBlock FontSize="13" Text="打开 RAMMap" />
                </StackPanel>
            </Button>
            <ToggleSwitch x:Name="ScheduleToggle" Grid.Column="5" Header="定时清理" OnContent="已开启" OffContent="已关闭"
                          Toggled="ScheduleToggle_Toggled" />
        </Grid>

        <!-- ===== 定时清理设置 ===== -->
        <Grid x:Name="SchedulePanel" Grid.Row="2" Padding="20,6,20,6" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="清理间隔" FontSize="13" VerticalAlignment="Center" Opacity="0.8" />
            <NumberBox x:Name="IntervalBox" Grid.Column="1" Width="110" Minimum="1" Maximum="1440" SmallChange="1"
                       SpinButtonPlacementMode="Compact" ValueChanged="IntervalBox_ValueChanged" />
            <TextBlock Grid.Column="2" Text="分钟" FontSize="13" VerticalAlignment="Center" Opacity="0.8" />
            <TextBlock Grid.Column="3" Text="内存阈值" FontSize="13" VerticalAlignment="Center" Opacity="0.8" Margin="16,0,0,0" />
            <NumberBox x:Name="ThresholdBox" Grid.Column="4" Width="110" Minimum="1" Maximum="524288" SmallChange="1"
                       SpinButtonPlacementMode="Compact" ValueChanged="ThresholdBox_ValueChanged" />
            <TextBlock Grid.Column="5" Text="GB" FontSize="13" VerticalAlignment="Center" Opacity="0.8" />
            <ComboBox x:Name="CleanTypeCombo" Grid.Column="6" Width="150" SelectionChanged="CleanTypeCombo_SelectionChanged" />
            <TextBlock x:Name="LastCleanText" Grid.Column="7" FontSize="12" Opacity="0.6"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Text="上次清理: --" />
        </Grid>

        <!-- ===== RAMMap 式分析面板 (Pivot 分页) ===== -->
        <Pivot Grid.Row="3" Margin="20,4,20,10">
            <PivotItem Header="使用量">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Padding="0,6,0,0">
                    <StackPanel Spacing="12">
                        <!-- 内存列表 (Use Counts) -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="15" FontWeight="Bold" Text="内存列表 (Use Counts)" Margin="0,0,0,4" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="已使用 (In Use)" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="InUseBar" Grid.Column="1" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="InUseText" Grid.Column="2" FontSize="13" FontWeight="Bold" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="InUsePctText" Grid.Column="3" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="已修改 (Modified)" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="ModifiedBar" Grid.Column="1" Grid.Row="1" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ModifiedText" Grid.Column="2" Grid.Row="1" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ModifiedPctText" Grid.Column="3" Grid.Row="1" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="待机 (Standby)" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="StandbyBar" Grid.Column="1" Grid.Row="2" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StandbyText" Grid.Column="2" Grid.Row="2" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StandbyPctText" Grid.Column="3" Grid.Row="2" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="空闲 (Free)" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="FreeBar" Grid.Column="1" Grid.Row="3" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FreeText" Grid.Column="2" Grid.Row="3" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FreePctText" Grid.Column="3" Grid.Row="3" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="4" Text="零页 (Zero)" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="ZeroBar" Grid.Column="1" Grid.Row="4" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ZeroText" Grid.Column="2" Grid.Row="4" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ZeroPctText" Grid.Column="3" Grid.Row="4" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="5" Text="错误页 (Bad)" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="BadBar" Grid.Column="1" Grid.Row="5" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BadText" Grid.Column="2" Grid.Row="5" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BadPctText" Grid.Column="3" Grid.Row="5" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="6" Text="硬件保留 (Reserved)" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HardwareReservedText" Grid.Column="2" Grid.Row="6" FontSize="12" Opacity="0.7" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 已使用分解 (In Use Breakdown) -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="15" FontWeight="Bold" Text="已使用分解" Margin="0,0,0,4" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="分页池 (Paged Pool)" FontSize="12.5" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="PoolPagedBar" Grid.Column="1" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PoolPagedText" Grid.Column="2" FontSize="12.5" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PoolPagedPctText" Grid.Column="3" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="非分页池 (Nonpaged)" FontSize="12.5" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="PoolNonpagedBar" Grid.Column="1" Grid.Row="1" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PoolNonpagedText" Grid.Column="2" Grid.Row="1" FontSize="12.5" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PoolNonpagedPctText" Grid.Column="3" Grid.Row="1" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="系统缓存 (Cache)" FontSize="12.5" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="SysCacheBar" Grid.Column="1" Grid.Row="2" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SysCacheText" Grid.Column="2" Grid.Row="2" FontSize="12.5" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SysCachePctText" Grid.Column="3" Grid.Row="2" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="系统代码 (Code)" FontSize="12.5" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="SysCodeBar" Grid.Column="1" Grid.Row="3" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SysCodeText" Grid.Column="2" Grid.Row="3" FontSize="12.5" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SysCodePctText" Grid.Column="3" Grid.Row="3" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="4" Text="系统驱动 (Driver)" FontSize="12.5" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="SysDriverBar" Grid.Column="1" Grid.Row="4" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SysDriverText" Grid.Column="2" Grid.Row="4" FontSize="12.5" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SysDriverPctText" Grid.Column="3" Grid.Row="4" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="5" Text="其他已使用" FontSize="12.5" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="OtherInUseBar" Grid.Column="1" Grid.Row="5" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OtherInUseText" Grid.Column="2" Grid.Row="5" FontSize="12.5" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OtherInUsePctText" Grid.Column="3" Grid.Row="5" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 提交限制 + 系统工作集 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                                <StackPanel Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A8;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="15" FontWeight="Bold" Text="提交限制 (虚拟内存)" />
                                    </StackPanel>
                                    <TextBlock FontSize="22" FontWeight="Bold" x:Name="CommitUsedText" Text="已用 --" />
                                    <TextBlock FontSize="12" Opacity="0.7" x:Name="CommitAvailText" Text="可用 --" />
                                    <TextBlock FontSize="12" Opacity="0.7" x:Name="CommitTotalText" Text="总共 --" />
                                    <ProgressBar x:Name="CommitBar" Height="5" Maximum="100" Value="0" Margin="0,4,0,0" />
                                    <TextBlock x:Name="CommitPctText" FontSize="11" Opacity="0.6" Text="已使用 0%" />
                                    <TextBlock x:Name="VirtualPageFileText" FontSize="11" Opacity="0.45" TextWrapping="Wrap"
                                               Text="分页文件: --" />
                                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                                               Text="提交限制=物理内存+分页文件，占用率高属正常。" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                                <StackPanel Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE90F;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="15" FontWeight="Bold" Text="系统工作集" />
                                    </StackPanel>
                                    <TextBlock FontSize="22" FontWeight="Bold" x:Name="WsUsedText" Text="已用 --" />
                                    <TextBlock FontSize="12" Opacity="0.7" x:Name="WsAvailText" Text="可用 --" />
                                    <TextBlock FontSize="12" Opacity="0.7" x:Name="WsTotalText" Text="总共 --" />
                                    <ProgressBar x:Name="WsBar" Height="5" Maximum="100" Value="0" Margin="0,4,0,0" />
                                    <TextBlock x:Name="WsPctText" FontSize="11" Opacity="0.6" Text="已使用 0%" />
                                    <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                                               Text="所有进程正攥在物理内存里的数据总和。" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="进程">
                <Grid Padding="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D5;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="15" FontWeight="Bold" Text="进程工作集明细" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProcCountText" Grid.Column="2" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Padding="0,4,8,4" ColumnSpacing="8" Opacity="0.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11" Text="进程" />
                        <TextBlock Grid.Column="1" FontSize="11" Text="工作集" />
                        <TextBlock Grid.Column="2" FontSize="11" Text="私有内存" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" FontSize="11" Text="分页池" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" FontSize="11" Text="非分页池" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" FontSize="11" Text="虚拟内存" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="ProcList" Grid.Row="2" SelectionMode="None" Padding="0" Margin="0,2,0,0" />
                </Grid>
            </PivotItem>

            <PivotItem Header="优先级">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Padding="0,6,0,0">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="15" FontWeight="Bold" Text="优先级汇总 (Priority Summary)" Margin="0,0,0,4" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="保留优先级待机" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="ReserveBar" Grid.Column="1" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ReserveText" Grid.Column="2" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ReservePctText" Grid.Column="3" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="正常优先级待机" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="NormalBar" Grid.Column="1" Grid.Row="1" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NormalText" Grid.Column="2" Grid.Row="1" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NormalPctText" Grid.Column="3" Grid.Row="1" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="核心优先级待机" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="CoreBar" Grid.Column="1" Grid.Row="2" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CoreText" Grid.Column="2" Grid.Row="2" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CorePctText" Grid.Column="3" Grid.Row="2" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="已修改列表" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="ModListBar" Grid.Column="1" Grid.Row="3" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ModListText" Grid.Column="2" Grid.Row="3" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ModListPctText" Grid.Column="3" Grid.Row="3" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="4" Text="空闲 &amp; 零页" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="FreeZeroBar" Grid.Column="1" Grid.Row="4" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FreeZeroText" Grid.Column="2" Grid.Row="4" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FreeZeroPctText" Grid.Column="3" Grid.Row="4" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                   Text="说明：RAMMap 原生按 8 级优先级展示待机列表；本工具通过系统性能计数器读取，合并为核心/正常/保留三个优先级桶。清理待机内存会把各优先级待机一并清空。" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="物理内存">
                <Grid Padding="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE96C;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="15" FontWeight="Bold" Text="物理内存模块" VerticalAlignment="Center" />
                        <TextBlock x:Name="PhysSummaryText" Grid.Column="2" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <Button x:Name="PhysRefreshButton" Grid.Column="3" Click="PhysRefreshButton_Click" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock FontSize="12" Text="刷新" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Padding="0,4,8,4" ColumnSpacing="8" Opacity="0.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11" Text="插槽 (DeviceLocator)" />
                        <TextBlock Grid.Column="1" FontSize="11" Text="容量" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" FontSize="11" Text="速度" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" FontSize="11" Text="类型" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" FontSize="11" Text="制造商" />
                        <TextBlock Grid.Column="5" FontSize="11" Text="型号 (PartNumber)" />
                    </Grid>
                    <ListView x:Name="PhysList" Grid.Row="2" SelectionMode="None" Padding="0" Margin="0,2,0,0" />
                </Grid>
            </PivotItem>

            <PivotItem Header="文件缓存">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Padding="0,6,0,0">
                    <StackPanel Spacing="12">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="15" FontWeight="Bold" Text="系统文件缓存汇总 (File Summary)" Margin="0,0,0,4" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="系统缓存 (Cache Bytes)" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="CacheBytesBar" Grid.Column="1" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CacheBytesText" Grid.Column="2" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CacheBytesPctText" Grid.Column="3" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="系统缓存驻留" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="SysCacheResBar" Grid.Column="1" Grid.Row="1" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SysCacheResText" Grid.Column="2" Grid.Row="1" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SysCacheResPctText" Grid.Column="3" Grid.Row="1" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="缓存峰值" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="CachePeakBar" Grid.Column="1" Grid.Row="2" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CachePeakText" Grid.Column="2" Grid.Row="2" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CachePeakPctText" Grid.Column="3" Grid.Row="2" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="分页池驻留" FontSize="13" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="PoolPagedResBar" Grid.Column="1" Grid.Row="3" Maximum="100" Value="0" Height="5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PoolPagedResText" Grid.Column="2" Grid.Row="3" FontSize="13" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PoolPagedResPctText" Grid.Column="3" Grid.Row="3" FontSize="11" Opacity="0.6" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 分页文件磁盘占用 -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="15" FontWeight="Bold" Text="分页文件磁盘占用" Margin="0,0,0,4" />
                                <Grid Padding="0,2,8,4" ColumnSpacing="8" Opacity="0.6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="11" Text="分页文件" />
                                    <TextBlock Grid.Column="1" FontSize="11" Text="当前使用" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" FontSize="11" Text="已分配" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" FontSize="11" Text="占用率" HorizontalAlignment="Right" />
                                </Grid>
                                <ListView x:Name="PfUsageList" SelectionMode="None" Padding="0" Margin="0,2,0,0" MaxHeight="220" />
                                <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                           Text="说明：RAMMap 的 File Details 页需内核级枚举才能列出每个文件占用的物理页；本工具通过性能计数器展示系统级缓存汇总。磁盘文件级明细可打开 RAMMap 图形界面查看。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="虚拟内存">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Padding="0,6,0,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A8;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" FontSize="15" FontWeight="Bold" Text="虚拟内存设置 (分页文件)" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Click="OpenSystemSettingsButton_Click"
                                    ToolTipService.ToolTip="打开系统性能选项">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                                    <TextBlock FontSize="12" Text="打开系统设置" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="AdminHintText" FontSize="11" Opacity="0.7"
                                   Text="修改分页文件需要管理员权限，应用后重启电脑生效。" />
                        <ToggleSwitch x:Name="AutoManageToggle" Header="自动管理所有驱动器的分页文件大小"
                                      OnContent="已启用" OffContent="已关闭" Toggled="AutoManageToggle_Toggled" Margin="0,0,0,4" />
                        <Grid Padding="0,2,8,4" ColumnSpacing="8" Opacity="0.6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11" Text="驱动器" />
                            <TextBlock Grid.Column="1" FontSize="11" Text="分页方式" />
                            <TextBlock Grid.Column="2" FontSize="11" Text="初始大小 (MB)" />
                            <TextBlock Grid.Column="3" FontSize="11" Text="最大大小 (MB)" />
                        </Grid>
                        <StackPanel x:Name="PageFilePanel" Spacing="2" />
                        <Grid ColumnSpacing="10" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="SavePageFileButton_Click" Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                    <TextBlock FontSize="13" Text="保存设置" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="PageFileStatusText" Grid.Column="1" FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center" Text="当前状态读取自注册表" />
                            <Button Grid.Column="2" Click="ReloadPageFileButton_Click"
                                    ToolTipService.ToolTip="重新读取分页文件设置">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock FontSize="12" Text="刷新" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!-- ===== 底部状态条 ===== -->
        <InfoBar x:Name="ToastBar" Grid.Row="3" IsClosable="True" IsOpen="False" VerticalAlignment="Bottom" />
    </Grid>
</Page>