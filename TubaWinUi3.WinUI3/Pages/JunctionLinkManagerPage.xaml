<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.JunctionLinkManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TubaWinUi3.Pages"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <local:StateToTextConverter x:Key="StateText"/>
        <local:StateToBrushConverter x:Key="StateBrush"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:MigratedBrushConverter x:Key="MigratedBrush"/>

        <!-- 个人文件夹行模板：图标 / 状态徽章 / 名称+当前路径 / 操作按钮 -->
        <DataTemplate x:Key="FolderRowTemplate">
        <Grid Padding="8,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="18" VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Background="{Binding State, Converter={StaticResource StateBrush}}">
                <TextBlock Text="{Binding State, Converter={StaticResource StateText}}" FontSize="11" Foreground="White"/>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding CurrentPath}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                           IsTextSelectionEnabled="True" ToolTipService.ToolTip="{Binding CurrentPath}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="更改位置…" FontSize="12" Padding="10,4" Click="ChangeBtn_Click"/>
                <Button Content="还原默认" FontSize="12" Padding="10,4" Click="RestoreBtn_Click"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- AppData 按应用行模板：勾选 / 应用名+路径 / 区域 / 大小 / 状态 / 撤销 -->
    <DataTemplate x:Key="AppDataAppRowTemplate">
        <Grid Padding="8,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                      MinWidth="0" Padding="0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding Source}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding Source}" FontSize="10" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Area}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Border Grid.Column="4" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Background="{Binding Migrated, Converter={StaticResource MigratedBrush}}">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White"/>
            </Border>
            <Button Grid.Column="5" Content="撤销迁移" FontSize="12" Padding="10,4" Click="UndoAppBtn_Click"
                    Visibility="{Binding Migrated, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </DataTemplate>

    <!-- 自定义超链接行模板：图标 / 原位置 / 新位置 / 撤销按钮 -->
    <DataTemplate x:Key="CustomRowTemplate">
        <Grid Padding="8,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE71B;" FontSize="16" VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding SourceDisplay}" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding Source}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="原位置（超链接）" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding TargetDisplay}" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding Target}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="新位置（实际文件）" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button Grid.Column="4" Content="撤销迁移" FontSize="12" Padding="10,4" Click="UndoJunctionBtn_Click"/>
        </Grid>
    </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Padding="24,20,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE71B;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="22" FontWeight="Bold" Text="超链接管理器" />
                <TextBlock FontSize="11" Opacity="0.8" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                           Text="把桌面/下载等文件夹迁移到其他盘，在原位置创建超链接（NTFS Junction），旧路径仍可正常访问。" />
            </StackPanel>
            <Button Grid.Column="2" Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
            <StackPanel Spacing="14">
                <InfoBar x:Name="GuideBar" Severity="Informational" IsOpen="True" IsClosable="False" Title="说明"
                         Message="重定向 = 原文件迁移到新位置 + 原位置创建超链接 + 系统已知文件夹指向新位置（写入后会自动回读验证）。资源管理器在启动时会缓存文件夹路径，请在确认框勾选「完成后立即重启资源管理器」使其立即生效。AppData 支持按应用选择性迁移（见下方列表）。" />

                <InfoBar x:Name="ToastBar" IsClosable="True" IsOpen="False" />

                <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <ProgressRing x:Name="ProgressRing" Width="24" Height="24" IsActive="True" />
                    <TextBlock x:Name="ProgressText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CancelBtn" Content="取消" FontSize="12" Click="CancelBtn_Click" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="个人文件夹" />
                    <Border BorderThickness="1" CornerRadius="6">
                        <ListView x:Name="FolderList" SelectionMode="None" ItemTemplate="{StaticResource FolderRowTemplate}" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="应用数据 AppData（按应用迁移）" VerticalAlignment="Center" />
                        <Button x:Name="ExpandAppDataBtn" Grid.Column="1" Click="ExpandAppDataBtn_Click" Content="展开全部" FontSize="12" />
                        <Button x:Name="RefreshAppDataBtn" Grid.Column="2" Click="RefreshAppDataBtn_Click" FontSize="12" ToolTipService.ToolTip="重新扫描 AppData">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                        <Button x:Name="MigrateAppsBtn" Grid.Column="3" Click="MigrateAppsBtn_Click" FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71B;" FontSize="12" />
                                <TextBlock Text="迁移所选…" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border BorderThickness="1" CornerRadius="6">
                        <ListView x:Name="AppDataList" SelectionMode="None" ItemTemplate="{StaticResource AppDataAppRowTemplate}" />
                    </Border>
                    <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Text="按占用大小排列，默认展示最大的 5 个应用，可展开全部。勾选应用后点「迁移所选…」选择目标盘：逐个迁移并在原位置创建超链接，任意一步失败自动回滚；已迁移的可在列表内撤销。系统组件 Microsoft 与商店应用 Packages 已排除。迁移前建议先退出对应软件。" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="自定义文件夹超链接" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="NewJunctionBtn" Click="NewJunctionBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71B;" FontSize="12" />
                                <TextBlock Text="选择文件夹并迁移…" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border BorderThickness="1" CornerRadius="6">
                        <ListView x:Name="CustomList" SelectionMode="None" ItemTemplate="{StaticResource CustomRowTemplate}" />
                    </Border>
                    <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Text="可迁移任意其他文件夹（软件缓存、项目目录、游戏存档等）：全部文件复制到新位置，原位置自动创建超链接，使用旧路径的程序不受影响。迁移前建议先退出相关程序；「撤销迁移」会把文件自动搬回。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>