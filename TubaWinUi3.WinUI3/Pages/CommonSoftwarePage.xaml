<Page
    x:Class="TubaWinUi3.Pages.CommonSoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="0" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,20,24,4" Spacing="2">
            <TextBlock Text="常用软件" FontSize="24" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="精选常用软件，基于 winget 一键批量安装，适合新机配置与软件迁移"
                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Search + Chips + Stats -->
        <StackPanel Grid.Row="1" Padding="24,8,24,0" Spacing="10">
            <TextBox x:Name="SearchBox" PlaceholderText="搜索软件名称或描述..." FontSize="13"
                     TextChanged="SearchBox_TextChanged"/>

            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="6"/>
            </ScrollViewer>

            <Grid x:Name="StatsPanel" ColumnSpacing="10" Margin="0,2,0,0"/>

            <Border x:Name="DetectionBar" CornerRadius="8" Padding="12,8" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="DetectionRing" Width="16" Height="16" IsActive="True"/>
                    <TextBlock x:Name="DetectionText" Grid.Column="1" Text="正在检测已安装软件..."
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ProgressBar x:Name="DetectionProgress" Grid.Column="2" Width="140"
                                 IsIndeterminate="False" Value="0" Maximum="100" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Package List -->
        <ScrollViewer Grid.Row="2" Padding="24,10,24,8" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PackageList" Spacing="6"/>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Padding="24,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <Button x:Name="SelectRecommendedBtn" Grid.Column="1" Content="仅选推荐"
                        Click="SelectRecommended_Click"/>
                <Button x:Name="SelectAllBtn" Grid.Column="2" Content="全选" Click="SelectAll_Click"/>
                <Button x:Name="DeselectAllBtn" Grid.Column="3" Content="取消全选" Click="DeselectAll_Click"/>
                <Button x:Name="InstallBtn" Grid.Column="4" Content="一键安装" IsEnabled="False"
                        Style="{ThemeResource AccentButtonStyle}" Click="Install_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
