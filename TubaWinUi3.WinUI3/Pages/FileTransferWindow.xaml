<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TubaWinUi3.Pages.FileTransferWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,20,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE8AB;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="文件传输助手" />
                <TextBlock x:Name="StatusText" Opacity="1.0" FontSize="12" Text="未加入群组" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel x:Name="MainPanel" Spacing="14">
                <InfoBar x:Name="ToastBar" IsClosable="True" IsOpen="False" />

                <Border x:Name="NoGroupCard" Padding="16" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="创建或加入群组" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBox x:Name="GroupNameInput" Header="群组名称" PlaceholderText="我的传输群组" />
                                <PasswordBox x:Name="GroupPasswordInput" Header="密码 (可选)" PlaceholderText="留空则无密码" />
                                <Button x:Name="CreateGroupButton" Click="CreateGroupButton_Click" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="创建群组" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBox x:Name="JoinCodeInput" Header="群组码" PlaceholderText="输入6位群组码" MaxLength="6" CharacterCasing="Upper" />
                                <PasswordBox x:Name="JoinPasswordInput" Header="密码 (如有)" PlaceholderText="输入群组密码" />
                                <Button x:Name="JoinGroupButton" Click="JoinGroupButton_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="12" />
                                        <TextBlock Text="加入群组" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="GroupInfoCard" Padding="16" CornerRadius="8" BorderThickness="1" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="当前群组" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Opacity="0.7" FontSize="12" Text="群组码:" />
                                    <TextBlock x:Name="GroupCodeText" FontSize="14" FontWeight="Bold" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Opacity="0.7" FontSize="12" Text="群组名:" />
                                    <TextBlock x:Name="GroupNameText" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="CopyCodeButton" Grid.Column="1" Click="CopyCodeButton_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                    <TextBlock Text="复制群组码" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LeaveGroupButton" Grid.Column="2" Click="LeaveGroupButton_Click" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    <TextBlock Text="离开群组" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="DeviceListCard" Padding="16" CornerRadius="8" BorderThickness="1" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="在线设备" />
                            <TextBlock x:Name="DeviceCountText" Grid.Column="1" FontSize="12" Opacity="0.7" />
                        </Grid>
                        <ListView x:Name="DeviceListView" SelectionMode="None" MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <FontIcon FontSize="14" Glyph="&#xE779;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" Text="{Binding DeviceName}" />
                                            <TextBlock FontSize="10" Opacity="0.6" Text="{Binding LanIp}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="6,2" CornerRadius="4" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
                                            <TextBlock FontSize="10" Text="{Binding ConnectionTypeLabel}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="发送文件" />
                        <Border x:Name="DropZone" Padding="20" CornerRadius="6" BorderThickness="2"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon Glyph="&#xE898;" FontSize="24" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Text="拖拽文件到此处发送" HorizontalAlignment="Center" Opacity="0.6" FontSize="13" />
                                <TextBlock x:Name="DropZoneHint" Text="或点击下方按钮选择文件" HorizontalAlignment="Center" FontSize="11" Opacity="0.4" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SelectFileButton" Click="SelectFileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="12" />
                                    <TextBlock Text="选择文件" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SendToAllButton" Click="SendToAllButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="发送给所有人" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="12,8" CornerRadius="8,8,0,0" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="方向" />
                                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="文件名" />
                                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="大小" />
                                <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="进度" />
                                <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="速度" />
                                <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="连接" />
                                <TextBlock Grid.Column="6" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="操作" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" x:Name="TransferListContainer" />

                        <StackPanel x:Name="EmptyTransferPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="0,30">
                            <FontIcon Glyph="&#xE8AB;" FontSize="36" Opacity="0.3" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无传输任务" HorizontalAlignment="Center" Opacity="0.5" />
                            <TextBlock Text="加入群组后即可开始传输文件" HorizontalAlignment="Center" FontSize="11" Opacity="0.3" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE912;" FontSize="12" />
                            <TextBlock Text="信令服务器设置" FontSize="12" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8" Padding="8">
                        <TextBox x:Name="SignalingUrlInput" Header="信令服务器 URL" PlaceholderText="wss://your-worker.workers.dev" />
                        <Button x:Name="SaveSignalingUrlButton" Click="SaveSignalingUrlButton_Click" Content="保存" HorizontalAlignment="Right" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12,24,20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterStatusText" FontSize="12" Opacity="0.6" Text="就绪" />
        </Border>
    </Grid>
</Window>
