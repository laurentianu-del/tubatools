<Page
    x:Class="TubaWinUi3.Pages.WindowsOptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="0" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,20,24,4" Spacing="2">
            <TextBlock Text="Windows常规优化" FontSize="24" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="视觉、文件、隐私、网络、游戏与清理优化。开关型直接切换启用/还原，一次性操作点击执行，高危项会先弹出确认"
                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Optimize Items -->
        <ScrollViewer Grid.Row="1" Padding="24,12,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OptimizeList" Spacing="6"/>
        </ScrollViewer>
    </Grid>
</Page>
