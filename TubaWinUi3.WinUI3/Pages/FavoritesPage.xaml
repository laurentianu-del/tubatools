<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:NullToVisibilityConverter x:Key="NullToCollapse" />
        <local:HasAlternatesToVisibilityConverter x:Key="HasAlternatesToVis" />
        <local:NoAlternatesToVisibilityConverter x:Key="NoAlternatesToVis" />

        <MenuFlyout x:Key="FavItemFlyout">
            <MenuFlyoutItem x:Name="FavMenuToggleFavorite" Text="取消收藏" Click="FavMenu_ToggleFavorite">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE735;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="发送到桌面快捷方式" Click="FavMenu_SendToDesktop">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="以管理员身份运行" Click="FavMenu_RunAsAdmin" Icon="Admin" />
            <MenuFlyoutItem Text="打开工具所在目录" Click="FavMenu_OpenDirectory" Icon="Folder" />
            <MenuFlyoutItem x:Name="FavMenuOpenTutorial" Text="打开教程" Click="FavMenu_OpenTutorial" Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A1;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Name="FavArchSubmenu" Text="选择架构" Visibility="Collapsed">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE912;" />
                </MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
        </MenuFlyout>
        <Style x:Key="FavCardStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid>
    <ScrollViewer Padding="28,18,28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="30"
                    FontWeight="SemiBold"
                    Text="常用" />
                <TextBlock
                    x:Name="SubtitleText"
                    Opacity="1.0"
                    Text="你收藏的工具会显示在这里。" />
            </StackPanel>

            <StackPanel
                x:Name="FrequentSection"
                Spacing="10"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="6">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE734;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Text="常用推荐" />
                    <TextBlock
                        x:Name="FrequentSubtitle"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Opacity="1.0"
                        Text="基于使用频率智能排序" />
                </StackPanel>
                <ScrollViewer
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="FrequentPanel" Orientation="Horizontal" Spacing="10" />
                </ScrollViewer>
            </StackPanel>

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="44"
                        Height="44"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="22"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE735;" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="我的收藏" />
                        <TextBlock
                            x:Name="ToolCountText"
                            Opacity="1.0" />
                    </StackPanel>

                    <Button
                        x:Name="ClearAllButton"
                        Grid.Column="2"
                        Padding="12,6"
                        Click="ClearAllButton_Click"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                            <TextBlock Text="清空全部" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <GridView
                x:Name="ToolsGrid"
                IsItemClickEnabled="True"
                ItemClick="ToolsGrid_ItemClick"
                ItemContainerStyle="{StaticResource FavCardStyle}"
                SelectionMode="None"
                SizeChanged="ToolsGrid_SizeChanged">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            MinHeight="220"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            RightTapped="FavItem_RightTapped">
                            <Grid RowSpacing="7">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="48"
                                        Height="48"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Image
                                                Width="32"
                                                Height="32"
                                                Source="{Binding IconPath}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconPath, Converter={StaticResource NullToCollapse}}" />
                                            <FontIcon
                                                FontSize="24"
                                                Glyph="{Binding IconGlyph}"
                                                Visibility="{Binding IconGlyph, Converter={StaticResource NullToCollapse}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock
                                            FontFamily="{StaticResource AppFontFamily}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontFamily="{StaticResource AppFontFamily}"
                                            FontSize="12"
                                            Opacity="1.0"
                                            Text="{Binding Category}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    FontFamily="{StaticResource AppFontFamily}"
                                    Grid.Row="1"
                                    MaxLines="2"
                                    Opacity="1.0"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />

                                <Grid Grid.Row="2" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="8,3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontFamily="{StaticResource AppFontFamily}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{Binding Extension}" />
                                    </Border>

                                </Grid>

                                <Grid Grid.Row="3" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="0"
                                        Click="SendToDesktopButton_Click"
                                        ToolTipService.ToolTip="发送到桌面快捷方式">
                                        <FontIcon FontSize="12" Glyph="&#xE8AD;" />
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="0"
                                        Click="RunAsAdminButton_Click"
                                        ToolTipService.ToolTip="以管理员身份运行">
                                        <FontIcon FontSize="12" Glyph="&#xE7EF;" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        MinWidth="88"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="10,4"
                                        Click="LaunchButton_Click">
                                        <TextBlock
                                            FontFamily="{StaticResource AppFontFamily}"
                                            Text="{Binding LaunchButtonText}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="0"
                                        Click="RemoveFavoriteButton_Click"
                                        ToolTipService.ToolTip="取消收藏">
                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Glyph="&#xE735;"
                    Opacity="1.0" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    Opacity="1.0"
                    Text="还没有收藏的工具" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="1.0"
                    Text="在全部页面点击星标按钮即可收藏" />
            </StackPanel>

            <TeachingTip
                x:Name="ToolDetailTip"
                CloseButtonContent="关闭"
                PreferredPlacement="Right">
                <StackPanel MaxWidth="420" Spacing="8">
                    <TextBlock x:Name="DetailDescriptionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPublisherText" Opacity="1.0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailVersionText" Opacity="1.0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailPathText" Opacity="1.0" TextWrapping="Wrap" />
                </StackPanel>
            </TeachingTip>

            <InfoBar
                x:Name="StatusBar"
                HorizontalAlignment="Right"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
