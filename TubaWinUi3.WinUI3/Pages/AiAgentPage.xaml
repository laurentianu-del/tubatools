<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TubaWinUi3.Pages.AiAgentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 企业级 Agent 顶栏：会话、模型、权限、用量集中展示 -->
        <Border Padding="20,14" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="12"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE946;" FontSize="18"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TitleText" Text="新对话" FontSize="18"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border CornerRadius="10" Padding="8,3"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                            <TextBlock Text="Agent Workspace" FontSize="11"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="ModelStatusText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="RunStateText" Text="就绪" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="HeaderTokenText" Text="0 tokens" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="ProviderCombo" MinWidth="128" MaxWidth="168" Padding="10,5" FontSize="12"
                              DisplayMemberPath="Name" VerticalAlignment="Center" SelectionChanged="ProviderCombo_SelectionChanged"
                              ToolTipService.ToolTip="切换 AI 服务提供商（可在 设置 → AI 服务 中管理）" />
                    <ComboBox x:Name="ModelCombo" MinWidth="150" MaxWidth="210" Padding="10,5" FontSize="12"
                              DisplayMemberPath="DisplayText" VerticalAlignment="Center" SelectionChanged="ModelCombo_SelectionChanged"
                              ToolTipService.ToolTip="切换当前提供商的模型（下一条消息生效）" />
                    <ToggleSwitch x:Name="FullAccessToggle" MinWidth="0" Padding="0"
                                  OnContent="完全访问" OffContent="受控执行"
                                  FontSize="12" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="完全访问模式：AI 可直接执行命令、修改注册表等危险操作，无需逐项确认（谨慎使用）"
                                  Toggled="FullAccessToggle_Toggled" />
                    <Button x:Name="NewChatButton" Padding="12,7" CornerRadius="8" Click="NewChatButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="新对话" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryButton" Padding="12,7" CornerRadius="8" Click="HistoryButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81C;" FontSize="12" />
                            <TextBlock Text="历史" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AiSettingsButton" Padding="12,7" CornerRadius="8" Click="AiSettingsButton_Click"
                            ToolTipService.ToolTip="AI 服务设置（提供商 / API Key / 模型）">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 消息工作区 -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MsgScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="MsgPanel" MaxWidth="1040" HorizontalAlignment="Center"
                            Padding="24,18,24,16" />
            </ScrollViewer>
        </Grid>

        <!-- 输入控制台 -->
        <Border Grid.Row="2" Padding="20,12,20,18" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Spacing="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="QuickPillPanel" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>

                <Border CornerRadius="16" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputBox" MinHeight="46" MaxHeight="140"
                                 PlaceholderText="描述目标，或直接要求助手诊断、执行命令、整理报告…（Enter 发送，Shift+Enter 换行）"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="4,8" KeyDown="InputBox_KeyDown" />
                        <Border x:Name="TokenUsageBubble" Grid.Column="1" CornerRadius="12"
                                Padding="10,7" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTipService.ToolTip="本会话累计消耗的 tokens（多轮对话累加）">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE823;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="TokenUsageText" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="SendButton" Grid.Column="2" Width="44" Height="44"
                                CornerRadius="14" Click="SendButton_Click"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE72A;" FontSize="16"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Button>
                        <Button x:Name="StopButton" Grid.Column="2" Width="44" Height="44"
                                CornerRadius="14" Visibility="Collapsed" Click="StopButton_Click">
                            <FontIcon Glyph="&#xE71A;" FontSize="15" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
