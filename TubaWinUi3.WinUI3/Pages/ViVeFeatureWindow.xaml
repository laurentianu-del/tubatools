<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TubaWinUi3.Pages.ViVeFeatureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Padding="24,20,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE945;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Windows 功能开关" />
                <TextBlock Opacity="1.0" FontSize="12" Text="管理 Windows A/B 实验性功能开关，启用/禁用/重置隐藏功能" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Click="CloseButton_Click" Content="关闭" />
        </Grid>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
            <StackPanel Spacing="14">
                <InfoBar x:Name="UnsupportedBar" IsClosable="True" IsOpen="False" Severity="Error" Title="不支持" Message="当前系统版本不支持 ViVe 功能管理，需要 Windows 10 18963 或更高版本。" />
                <InfoBar x:Name="TipBar" IsClosable="True" IsOpen="True" Severity="Informational" Title="提示" Message="修改功能开关可能需要重启系统后生效，请谨慎操作。" />

                <!-- Quick action bar -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FeatureIdBox" PlaceholderText="输入功能 ID 或英文名称..." />
                    <Button x:Name="QuickEnableBtn" Grid.Column="1" Click="QuickEnableBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" />
                            <TextBlock Text="快速开启" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickDisableBtn" Grid.Column="2" Click="QuickDisableBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE894;" FontSize="12" />
                            <TextBlock Text="快速关闭" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Stat cards -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatTotal" Padding="12" CornerRadius="6" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="1.0" Text="总计" />
                            <TextBlock x:Name="TotalCountText" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatEnabled" Grid.Column="1" Padding="12" CornerRadius="6" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="1.0" Text="已开启" />
                            <TextBlock x:Name="EnabledCountText" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatDisabled" Grid.Column="2" Padding="12" CornerRadius="6" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="1.0" Text="已关闭" />
                            <TextBlock x:Name="DisabledCountText" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatDefault" Grid.Column="3" Padding="12" CornerRadius="6" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="1.0" Text="默认" />
                            <TextBlock x:Name="DefaultCountText" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Search & filter bar -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索功能 ID 或名称..." QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                    <ComboBox x:Name="StateFilterCombo" Grid.Column="1" MinWidth="120" SelectedIndex="0" SelectionChanged="StateFilterCombo_SelectionChanged">
                        <x:String>全部状态</x:String>
                        <x:String>已开启</x:String>
                        <x:String>已关闭</x:String>
                        <x:String>默认(未修改)</x:String>
                    </ComboBox>
                    <Button x:Name="RefreshBtn" Grid.Column="2" Click="RefreshBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreActionsBtn" Grid.Column="3" Click="MoreActionsBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                            <TextBlock Text="更多" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="CountText" Grid.Column="4" FontSize="12" Opacity="1.0" VerticalAlignment="Center" />
                </Grid>

                <InfoBar x:Name="ResultBar" IsClosable="True" IsOpen="False" />

                <!-- Column headers -->
                <Border x:Name="HeaderBorder" Padding="12,6,12,6" CornerRadius="6,6,0,0">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Opacity="1.0" Text="功能 ID" />
                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Opacity="1.0" Text="状态" />
                        <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Opacity="1.0" Text="名称" />
                        <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Opacity="1.0" Text="操作" />
                    </Grid>
                </Border>

                <!-- List -->
                <Border x:Name="ListBorder" BorderThickness="1" CornerRadius="0,0,6,6">
                    <StackPanel x:Name="ListContainer" />
                </Border>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,40,0,40" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE711;" FontSize="36" Opacity="1.0" />
                    <TextBlock FontSize="14" Opacity="1.0" Text="没有找到匹配的功能" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Loading -->
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Spacing="8" Padding="0,40,0,40" Visibility="Collapsed">
                    <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="True" />
                    <TextBlock FontSize="13" Opacity="1.0" Text="正在加载功能列表..." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
