<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TubaWinUi3.Pages.VideoProcessorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Padding="24,16,24,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE8B2;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="视频处理" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="FfmpegStatusText" FontSize="11" Text="FFmpeg: 检查中..." VerticalAlignment="Center" />
                    <HyperlinkButton x:Name="DeleteFfmpegBtn" Click="DeleteFfmpegBtn_Click" Visibility="Collapsed" Padding="4,0" FontSize="11">
                        <TextBlock Text="删除" />
                    </HyperlinkButton>
                </StackPanel>
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Click="CloseButton_Click" Content="关闭" />
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,16,24,20">
            <StackPanel x:Name="MainPanel" Spacing="16">

                <InfoBar x:Name="ToastBar" IsClosable="True" IsOpen="False" />

                <!-- ══════ FFmpeg download ══════ -->
                <Border x:Name="FfmpegDownloadPanel" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="需要下载 FFmpeg" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock FontSize="12" Opacity="0.8" TextWrapping="Wrap" Text="视频处理功能依赖 FFmpeg，首次使用需要下载（约 80MB）。下载后可离线使用，不会增加应用安装包体积。" />
                        <ProgressBar x:Name="FfmpegDownloadProgress" Value="0" Visibility="Collapsed" />
                        <TextBlock x:Name="FfmpegDownloadStatus" FontSize="11" Opacity="0.7" Visibility="Collapsed" />
                        <Button x:Name="DownloadFfmpegBtn" Click="DownloadFfmpegBtn_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                                <TextBlock Text="下载 FFmpeg" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ══════ Work area (hidden until ffmpeg ready) ══════ -->
                <StackPanel x:Name="WorkArea" Spacing="16" Visibility="Collapsed">

                    <!-- ── Section 1: Source ── -->
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="1. 导入源文件" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SourceFileBox" IsReadOnly="True" PlaceholderText="选择视频文件..." />
                                <Button Grid.Column="1" Click="BrowseSource_Click" Content="&#xE8E5; 浏览" />
                                <Button Grid.Column="2" Click="AppendVideo_Click" ToolTipService.ToolTip="追加视频到末尾进行合并">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="追加" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="SourceInfoPanel" Padding="10" CornerRadius="6" Visibility="Collapsed">
                                <StackPanel x:Name="SourceInfoHost" Orientation="Horizontal" Spacing="16" />
                            </Border>

                            <StackPanel x:Name="AppendListPanel" Spacing="4" Visibility="Collapsed">
                                <TextBlock FontSize="12" Opacity="0.7" Text="追加的视频（按顺序合并到主视频之后）" />
                                <StackPanel x:Name="AppendListContainer" Spacing="2" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Section 2: Actions ── -->
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="2. 添加操作" />

                            <StackPanel Orientation="Horizontal" Spacing="6" x:Name="AddActionPanel">
                                <Button Click="AddAction_Click" Tag="Trim" FontSize="12" Padding="10,6" ToolTipService.ToolTip="裁剪时间片段">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE9A3;" FontSize="11" /><TextBlock Text="裁剪" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Compress" FontSize="12" Padding="10,6" ToolTipService.ToolTip="压缩视频体积">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE710;" FontSize="11" /><TextBlock Text="压缩" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Resize" FontSize="12" Padding="10,6" ToolTipService.ToolTip="调整分辨率">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE739;" FontSize="11" /><TextBlock Text="缩放" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Rotate" FontSize="12" Padding="10,6" ToolTipService.ToolTip="旋转/翻转">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE7AD;" FontSize="11" /><TextBlock Text="旋转" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Crop" FontSize="12" Padding="10,6" ToolTipService.ToolTip="裁剪画面">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE7A8;" FontSize="11" /><TextBlock Text="裁剪画面" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Speed" FontSize="12" Padding="10,6" ToolTipService.ToolTip="变速">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xEC4A;" FontSize="11" /><TextBlock Text="变速" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Volume" FontSize="12" Padding="10,6" ToolTipService.ToolTip="调整音量">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE767;" FontSize="11" /><TextBlock Text="音量" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="RemoveAudio" FontSize="12" Padding="10,6" ToolTipService.ToolTip="移除音频">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE7E8;" FontSize="11" /><TextBlock Text="静音" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="ExtractAudio" FontSize="12" Padding="10,6" ToolTipService.ToolTip="提取音频轨道">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xEA69;" FontSize="11" /><TextBlock Text="提取音频" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="ReplaceAudio" FontSize="12" Padding="10,6" ToolTipService.ToolTip="替换音频轨道">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE8D6;" FontSize="11" /><TextBlock Text="替换音频" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Watermark" FontSize="12" Padding="10,6" ToolTipService.ToolTip="图片/文字水印">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE7BA;" FontSize="11" /><TextBlock Text="水印" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Filter" FontSize="12" Padding="10,6" ToolTipService.ToolTip="亮度/对比度/饱和度/风格滤镜">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE790;" FontSize="11" /><TextBlock Text="滤镜" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="MakeGif" FontSize="12" Padding="10,6" ToolTipService.ToolTip="转为 GIF 动图">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE8B2;" FontSize="11" /><TextBlock Text="GIF" /></StackPanel>
                                </Button>
                                <Button Click="AddAction_Click" Tag="Custom" FontSize="12" Padding="10,6" ToolTipService.ToolTip="直接输入 FFmpeg 参数">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE9D9;" FontSize="11" /><TextBlock Text="自定义" /></StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="ActionListContainer" Spacing="4" />
                            <TextBlock x:Name="ActionEmptyHint" FontSize="12" Opacity="0.4" Text="点击上方按钮添加操作，操作按顺序依次执行" />
                        </StackPanel>
                    </Border>

                    <!-- ── Section 3: Output ── -->
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="3. 输出设置" />

                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Opacity="0.8" Text="输出格式" />
                                <GridView x:Name="FormatGrid" SelectionMode="Single" SelectionChanged="FormatGrid_SelectionChanged">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                            </StackPanel>

                            <Grid x:Name="CodecPanel" ColumnSpacing="12" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="12" Opacity="0.8" Text="视频编码" />
                                    <ComboBox x:Name="VideoCodecCombo" MinWidth="200" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock FontSize="12" Opacity="0.8" Text="音频编码" />
                                    <ComboBox x:Name="AudioCodecCombo" MinWidth="200" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12" x:Name="QualityPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="12" Opacity="0.8" Text="质量 CRF (0-51, 越低越好)" />
                                    <Slider x:Name="CrfSlider" Minimum="0" Maximum="51" Value="23" StepFrequency="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock FontSize="12" Opacity="0.8" Text="编码预设" />
                                    <ComboBox x:Name="PresetCombo" MinWidth="160" HorizontalAlignment="Stretch" SelectedIndex="5">
                                        <x:String>ultrafast</x:String>
                                        <x:String>superfast</x:String>
                                        <x:String>veryfast</x:String>
                                        <x:String>faster</x:String>
                                        <x:String>fast</x:String>
                                        <x:String>medium</x:String>
                                        <x:String>slow</x:String>
                                        <x:String>slower</x:String>
                                        <x:String>veryslow</x:String>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputFileBox" PlaceholderText="自动生成..." TextChanged="OutputFileBox_TextChanged" />
                                <Button Grid.Column="1" Click="BrowseOutput_Click" Content="&#xE8E5; 另存为" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Start ── -->
                    <Button x:Name="StartBtn" Click="StartBtn_Click" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="开始处理" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="ProgressPanel" Spacing="6" Visibility="Collapsed">
                        <ProgressBar x:Name="TaskProgress" IsIndeterminate="True" />
                        <TextBlock x:Name="ProgressText" FontSize="11" Opacity="0.7" Text="正在处理..." />
                        <Button x:Name="CancelBtn" Click="CancelBtn_Click" HorizontalAlignment="Left" Content="取消" FontSize="12" Padding="12,4" />
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
