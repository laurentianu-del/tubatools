<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TubaWinUi3.Pages.MemoryManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏 ===== -->
        <Grid Padding="20,16,20,12" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="BackButton_Click" ToolTipService.ToolTip="返回" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    <TextBlock FontSize="13" Text="返回" />
                </StackPanel>
            </Button>
            <Border Grid.Column="1" Width="36" Height="36" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8">
                <FontIcon FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE963;" />
            </Border>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="内存管理" />
                <TextBlock FontSize="12" Opacity="0.7" Text="内存状态实时监控 · 一键清理 · 虚拟内存设置" />
            </StackPanel>
            <Button x:Name="HelpButton" Grid.Column="3" Click="HelpButton_Click" VerticalAlignment="Center"
                    ToolTipService.ToolTip="了解这三种内存的含义">
                <FontIcon Glyph="&#xE897;" FontSize="14" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="4" Click="CloseButton_Click" Content="关闭" />
        </Grid>

        <!-- ===== 清理操作栏 ===== -->
        <Grid Grid.Row="1" Padding="20,14,20,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CleanAllButton" Grid.Column="0" Click="CleanAllButton_Click"
                    Style="{ThemeResource AccentButtonStyle}" MinWidth="110"
                    Content="全部清理" ToolTipService.ToolTip="清理待机内存 + 收紧系统工作集" />
            <Button x:Name="CleanStandbyButton" Grid.Column="1" Click="CleanStandbyButton_Click" MinWidth="110"
                    Content="清理待机内存" ToolTipService.ToolTip="清空待机列表与已修改内存列表" />
            <Button x:Name="TrimWorkingSetButton" Grid.Column="2" Click="TrimWorkingSetButton_Click" MinWidth="120"
                    Content="收紧系统工作集" ToolTipService.ToolTip="清空所有进程工作集并收缩系统文件缓存" />
            <ToggleSwitch x:Name="ScheduleToggle" Grid.Column="4" Header="定时清理" OnContent="已开启" OffContent="已关闭"
                          Toggled="ScheduleToggle_Toggled" />
        </Grid>

        <!-- ===== 定时清理设置 ===== -->
        <Grid x:Name="SchedulePanel" Grid.Row="2" Padding="20,6,20,6" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="清理间隔" FontSize="13" VerticalAlignment="Center" Opacity="0.8" />
            <NumberBox x:Name="IntervalBox" Grid.Column="1" Width="110" Minimum="1" Maximum="1440" SmallChange="1"
                       SpinButtonPlacementMode="Compact" ValueChanged="IntervalBox_ValueChanged" />
            <TextBlock Grid.Column="2" Text="分钟" FontSize="13" VerticalAlignment="Center" Opacity="0.8" />
            <TextBlock Grid.Column="3" Text="内存阈值" FontSize="13" VerticalAlignment="Center" Opacity="0.8" Margin="16,0,0,0" />
            <NumberBox x:Name="ThresholdBox" Grid.Column="4" Width="110" Minimum="1" Maximum="524288" SmallChange="1"
                       SpinButtonPlacementMode="Compact" ValueChanged="ThresholdBox_ValueChanged" />
            <TextBlock Grid.Column="5" Text="GB" FontSize="13" VerticalAlignment="Center" Opacity="0.8" />
            <ComboBox x:Name="CleanTypeCombo" Grid.Column="6" Width="150" SelectionChanged="CleanTypeCombo_SelectionChanged" />
            <TextBlock x:Name="LastCleanText" Grid.Column="7" FontSize="12" Opacity="0.6"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Text="上次清理: --" />
        </Grid>

        <!-- ===== 三大内存卡片 ===== -->
        <Grid Grid.Row="3" Padding="20,8,20,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 物理内存 -->
            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE963;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="物理内存" />
                    </StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" x:Name="PhysUsedText" Text="已用 --" />
                    <TextBlock FontSize="12" Opacity="0.7" x:Name="PhysAvailText" Text="可用 --" />
                    <TextBlock FontSize="12" Opacity="0.7" x:Name="PhysTotalText" Text="总共 --" />
                    <ProgressBar x:Name="PhysBar" Height="5" Maximum="100" Value="0" Margin="0,4,0,0" />
                    <TextBlock x:Name="PhysPercentText" FontSize="11" Opacity="0.6" Text="已使用 0%" />
                </StackPanel>
            </Border>

            <!-- 虚拟内存 -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A8;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="虚拟内存" />
                    </StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" x:Name="VirtualUsedText" Text="已用 --" />
                    <TextBlock FontSize="12" Opacity="0.7" x:Name="VirtualAvailText" Text="可用 --" />
                    <TextBlock FontSize="12" Opacity="0.7" x:Name="VirtualTotalText" Text="总共 --" />
                    <ProgressBar x:Name="VirtualBar" Height="5" Maximum="100" Value="0" Margin="0,4,0,0" />
                    <TextBlock x:Name="VirtualPercentText" FontSize="11" Opacity="0.6" Text="已使用 0%" />
                    <TextBlock x:Name="VirtualPageFileText" FontSize="11" Opacity="0.6" Text="分页文件: --" />
                    <TextBlock x:Name="VirtualNoteText" FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                               Text="虚拟内存=系统提交限制(物理内存+分页文件)，占用率高属正常" />
                </StackPanel>
            </Border>

            <!-- 系统工作集 -->
            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                <StackPanel Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE90F;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="系统工作集" />
                    </StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" x:Name="WsUsedText" Text="已用 --" />
                    <TextBlock FontSize="12" Opacity="0.7" x:Name="WsAvailText" Text="可用 --" />
                    <TextBlock FontSize="12" Opacity="0.7" x:Name="WsTotalText" Text="总共 --" />
                    <ProgressBar x:Name="WsBar" Height="5" Maximum="100" Value="0" Margin="0,4,0,0" />
                    <TextBlock x:Name="WsPercentText" FontSize="11" Opacity="0.6" Text="已使用 0%" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 底部: 进程排行 + 虚拟内存设置 ===== -->
        <Grid Grid.Row="4" Padding="20,8,20,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 进程内存占用排行 -->
            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D5;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Text="进程内存占用排行" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProcCountText" Grid.Column="2" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Padding="0,4,8,4" ColumnSpacing="8" Opacity="0.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11" Text="进程" />
                        <TextBlock Grid.Column="1" FontSize="11" Text="内存占用比例" />
                        <TextBlock Grid.Column="2" FontSize="11" Text="工作集内存" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="ProcList" Grid.Row="2" SelectionMode="None" Padding="0" Margin="0,2,0,0" />
                </Grid>
            </Border>

            <!-- 虚拟内存设置 -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A8;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Text="虚拟内存设置 (分页文件)" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="OpenSystemSettingsButton_Click"
                                ToolTipService.ToolTip="打开系统性能选项">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                                <TextBlock FontSize="12" Text="打开系统设置" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="AdminHintText" FontSize="11" Opacity="0.7" Margin="0,0,0,4"
                               Text="修改分页文件需要管理员权限，应用后重启电脑生效。" />
                    <ToggleSwitch x:Name="AutoManageToggle" Grid.Row="2" Header="自动管理所有驱动器的分页文件大小"
                                  OnContent="已启用" OffContent="已关闭" Toggled="AutoManageToggle_Toggled" Margin="0,0,0,4" />
                    <Grid Grid.Row="3" Padding="0,2,8,4" ColumnSpacing="8" Opacity="0.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11" Text="驱动器" />
                        <TextBlock Grid.Column="1" FontSize="11" Text="分页方式" />
                        <TextBlock Grid.Column="2" FontSize="11" Text="初始大小 (MB)" />
                        <TextBlock Grid.Column="3" FontSize="11" Text="最大大小 (MB)" />
                    </Grid>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel x:Name="PageFilePanel" Spacing="2" />
                    </ScrollViewer>
                    <Grid Grid.Row="5" ColumnSpacing="10" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="SavePageFileButton_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                <TextBlock FontSize="13" Text="保存设置" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PageFileStatusText" Grid.Column="1" FontSize="11" Opacity="0.6"
                                   VerticalAlignment="Center" Text="当前状态读取自注册表" />
                        <Button Grid.Column="2" Click="ReloadPageFileButton_Click"
                                ToolTipService.ToolTip="重新读取分页文件设置">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock FontSize="12" Text="刷新" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部状态条 ===== -->
        <InfoBar x:Name="ToastBar" Grid.Row="4" IsClosable="True" IsOpen="False" VerticalAlignment="Bottom" />
    </Grid>
</Window>
