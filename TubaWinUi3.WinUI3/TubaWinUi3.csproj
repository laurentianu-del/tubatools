<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TubaWinUi3</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.5.7</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA2252;CA2014;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TubaWinUi3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Fonts\*.ttf;Fonts\*.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(ExcludeToolsFromPublish)' != 'true'">
    <Content Include="Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="IconCache\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Metadata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- CLI 工具文档单一事实来源：仓库根目录（AI Agent 解析用） -->
    <Content Include="..\CLI工具使用文档.md" Link="Metadata\CLI工具使用文档.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="CertBlock\Certificates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="CertBlock\CertBlockAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>

  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.4" />

    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.2" />

    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />

    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />

    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="SIPSorcery" Version="10.0.11" />

    <PackageReference Include="System.Speech" Version="10.0.10" />

  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!--
    Pre-build the bundled icon cache (IconCache/) before publish so first launch
    does not need to extract icons. Up-to-date files are skipped by the script.
  -->
  <Target Name="GenerateBundledIconCache" BeforeTargets="Publish" Condition="'$(ExcludeToolsFromPublish)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build-icon-cache.ps1&quot; -ToolsRoot &quot;$(MSBuildProjectDirectory)\Tools&quot; -OutputDir &quot;$(MSBuildProjectDirectory)\IconCache&quot;" />
  </Target>

  <!--
    Pre-build the bundled tool catalog cache (Metadata/tool_cache.json) before
    publish: the app scans the Tools tree once in build-tool-cache mode and
    writes the final result, so end users get instant tool lists on first
    launch without scanning 500+ MB of tools. Generated file ships via the
    Metadata/** Content group. Skipped for lite builds (no Tools folder).
  -->
  <Target Name="GenerateBundledToolCache" BeforeTargets="Publish" Condition="'$(ExcludeToolsFromPublish)' != 'true'">
    <!-- 注意用 exe 而非 $(TargetPath)（dll）：unpackaged WinUI 必须经 exe 启动 -->
    <Exec Command="&quot;$(TargetDir)$(TargetName).exe&quot; --build-tool-cache &quot;$(MSBuildProjectDirectory)\Tools&quot; &quot;$(MSBuildProjectDirectory)\Metadata\tool_cache.json&quot;" />
    <!-- 生成发生在 Build 的内容复制之后，需补复制到输出目录才能随 publish 分发 -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Metadata\tool_cache.json" DestinationFolder="$(TargetDir)Metadata" />
  </Target>

  <!--
    Generate the subset MiSans font (Fonts/MiSans-Subset.otf) before publish so
    first frame rendering loads a small font instead of the 6.5MB original.
    Skips silently when fonttools is unavailable (falls back to the full font).
  -->
  <Target Name="GenerateBundledFontSubset" BeforeTargets="Publish">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build-font-subset.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Fonts\MiSans-Subset.otf" DestinationFolder="$(TargetDir)Fonts" Condition="Exists('$(MSBuildProjectDirectory)\Fonts\MiSans-Subset.otf')" />
  </Target>
</Project>
